<Project Sdk="Microsoft.NET.Sdk">

  <!-- Applies db/migrations/*.sql. Run locally against Docker Postgres, or against Aurora with IAM sign-in. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SeqTransit.Data\SeqTransit.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\db\migrations\*.sql" Link="migrations\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
